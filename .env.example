# Copy this file to .env and fill it in. .env is ignored by git.
# For the daily GitHub job, load the same values as repository secrets with:
#   gh secret set -f .env

# Required for drafting blurbs. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for the alert email. For Gmail, make an app password at
# https://myaccount.google.com/apppasswords (needs two-step verification).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# Optional. Defaults are Gmail's.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=

# Optional. OpenAlex is free without a key; a key raises the daily limit.
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.edu
